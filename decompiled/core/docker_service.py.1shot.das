                        b'<COAddr>\x01\x00\x00\x1a,\x00\x00\x00\x00\x00\x00\x00'
                        'import socket, time, re\n\ndef docker_api(method, path):\n    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)\n    s.settimeout(30)\n    s.connect("/var/run/docker.sock")\n    req = f"{method} {path} HTTP/1.1\\r\\nHost: localhost\\r\\nConnection: close\\r\\nContent-Length: 0\\r\\n\\r\\n"\n    s.sendall(req.encode())\n    resp = b""\n    try:\n        while True:\n            chunk = s.recv(4096)\n            if not chunk:\n                break\n            resp += chunk\n            if b"\\r\\n\\r\\n" in resp:\n                header_part = resp.split(b"\\r\\n\\r\\n")[0]\n                status_match = re.search(rb"HTTP/1\\.\\d (\\d+)", header_part)\n                if status_match:\n                    code = int(status_match.group(1))\n                    if code == 204 or code == 304:\n                        break\n                    cl_match = re.search(rb"Content-Length:\\s*(\\d+)", header_part, re.IGNORECASE)\n                    if cl_match:\n                        body_start = resp.index(b"\\r\\n\\r\\n") + 4\n                        if len(resp) - body_start >= int(cl_match.group(1)):\n                            break\n    except socket.timeout:\n        pass\n    s.close()\n    status = resp.split(b"\\r\\n")[0].decode() if resp else "no response"\n    print(f"[Sidecar] {method} {path} -> {status}")\n    return "200" in status or "204" in status or "304" in status\n\nprint("[Sidecar] NanShare 自更新开始")\ntime.sleep(1)\n\nprint("[Sidecar] 停止旧容器...")\ndocker_api("POST", "/containers/'
                        '/stop?t=10")\ntime.sleep(1)\n\nprint("[Sidecar] 启动新容器...")\nok = docker_api("POST", "/containers/'
                        '/start")\nif ok:\n    print("[Sidecar] ✅ 新容器已启动")\n    time.sleep(1)\n    print("[Sidecar] 清理旧容器...")\n    docker_api("DELETE", "/containers/'
                        '?force=true")\n    print("[Sidecar] ✅ 自更新完成")\nelse:\n    print("[Sidecar] ❌ 新容器启动失败，请手动检查")\n\nprint("[Sidecar] 退出")\n'
                        '__pyarmor_exit_7421__'
